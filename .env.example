# Copy to ~/.grokbot-bridge/.env (chmod 600) or set as real environment variables.
# Real env vars win over .env files. Never commit a filled-in .env.

# Base URL of the app's bridge route (the catch-all /api/grokbot/[...path] route).
GROKBOT_BRIDGE_URL=https://app.example.com/api/grokbot

# Shared enrollment secret from the app owner. Used once, by `enroll`.
# Prefer supplying it through your Grok Bot's secure secret input so it lands as an env var.
GROKBOT_ENROLLMENT_SECRET=

# Optional
# GROKBOT_BOT_ID=            # your agent id, if several agents share this box
# GROKBOT_BRIDGE_HOME=       # state dir, default ~/.grokbot-bridge
# GROKBOT_BRIDGE_TIMEOUT_MS= # HTTP timeout, default 10000
